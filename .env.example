# Copy to .env for local Compose deployment and replace the placeholder.
# AegisAI Sovereign Workbench Configuration Template
POSTGRES_PASSWORD=replace-with-a-local-secret
# Development/deployment provisioning only. Values are hashed before storage;
# the frontend never receives or supplies role/clearance selections.
AEGIS_BOOTSTRAP_USERS_JSON=[]

# System Environment
PROJECT_NAME="AegisAI"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Security & Compliance
SECRET_KEY="change-this-in-production-super-secret-sovereign-key"
CLASSIFICATION_TAG_DEFAULT="INTERNAL" # INTERNAL, RESTRICTED, CONFIDENTIAL
# Air-Gap / Sovereign Controls
EGRESS_MONITOR_ENABLED="true"
EGRESS_ENFORCE="true"
EGRESS_ALLOW_HOSTS=""

# PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="aegis_ai"
POSTGRES_USER="aegis_user"
POSTGRES_PASSWORD="aegis_secure_password"
DATABASE_URL="postgresql://aegis_user:aegis_secure_password@localhost:5432/aegis_ai"

# Qdrant Vector Database
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="aegis_documents"

# Redis Cache & Task Queue
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Local LLM & Ollama Engine
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_CHAT_MODEL="qwen2.5:3b"
DEFAULT_VISION_MODEL=""
DEFAULT_CODER_MODEL="qwen2.5-coder:3b"

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
